# Example only - the real file is created for you by `python manage.py init`
# and must never be committed. Do not put real values in this example.

APP_ENV=development
SECRET_KEY=                      # generated by `python manage.py init`

PAY_UPI_ID=
PAY_ACCOUNT_NAME=

CONTACT_EMAIL=                   # shown to signed-in clients only
CONTACT_WHATSAPP=                # e.g. +91 70200 00000
PUBLIC_CONTACT=0                 # 1 = show contact details to everyone

PUBLIC_RATE_CARD_SHOWS_MARGINS=0

